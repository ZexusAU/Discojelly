# --- Required ---------------------------------------------------------------
# Discord bot token (Developer Portal > your application > Bot > Reset Token)
DISCORD_BOT_TOKEN=
# ID of the channel where requests are posted (right-click channel > Copy Channel ID)
DISCORD_CHANNEL_ID=
# Where the bot can reach Jellyseerr. Do NOT add /api/v1, it is added for you.
JELLYSEERR_URL=http://192.168.1.10:5055
# Jellyseerr > Settings > General > API Key
JELLYSEERR_API_KEY=
# A long random string. Jellyseerr must send the same value in its
# "Authorization Header" webhook field. Generate one with:  openssl rand -hex 24
WEBHOOK_SECRET=

# --- Optional ---------------------------------------------------------------
# Who may press Approve/Decline. Comma-separated Discord IDs.
# If both are empty, only members with the "Manage Server" permission can.
ALLOWED_ROLE_IDS=
ALLOWED_USER_IDS=
# Adds an "Open in Jellyseerr" button using the address your browser uses.
JELLYSEERR_PUBLIC_URL=
# PORT=3000
# HOST=0.0.0.0
# LOG_LEVEL=info        # debug | info | warn | error
